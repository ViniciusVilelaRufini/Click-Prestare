# ===== Configuração do Agente Local =====
# Você só precisa de DUAS coisas. (O IP/usuário/senha de cada aparelho NÃO vai
# aqui — isso fica salvo na nuvem; você cadastra uma vez no portal.)

# 1) Endereço da API na nuvem (sem barra no final)
API_URL=https://api.prestarecondominios.com.br

# 2) UM token só, que gerencia TODOS os dispositivos do condomínio.
# Pegue no portal: Terminais de Dispositivos -> "Copiar URL Webhook" em qualquer
# dispositivo -> o token é o trecho final da URL (.../api/facial/webhook/<TOKEN>).
AGENT_TOKEN=cole_um_token_aqui

# Dica: você nem precisa editar este arquivo. Rode o click-agent.exe por uma
# janela de terminal uma vez e ele pergunta esses dois valores e salva sozinho.

# ----- Opcionais -----
# POLL_INTERVAL_MS=2000          # default vem da nuvem (mínimo aplicado: 1000)
# LAN_TIMEOUT_MS=8000            # timeout das chamadas (comandos) ao aparelho na LAN
# DEVICE_STATUS_INTERVAL_MS=5000 # intervalo do ping de status (online/offline)
# DEVICE_PING_TIMEOUT_MS=5000    # prazo do ping de status, por aparelho

# ----- Modo legado (opcional): um token por dispositivo -----
# Use SÓ se não quiser o modo condomínio acima. Deixe AGENT_TOKEN vazio.
# DEVICE_TOKENS=token_device_1,token_device_2
