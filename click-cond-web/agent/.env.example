# Base da API na nuvem (sem barra no final)
API_URL=https://sua-api.up.railway.app

# Tokens dos devices que este agente gerencia, separados por vírgula.
# Pegue cada token no portal: botão "Copiar URL Webhook" — o token é o
# trecho final da URL (.../api/facial/webhook/<TOKEN>).
DEVICE_TOKENS=token_device_1,token_device_2

# Opcionais
# POLL_INTERVAL_MS=2000   # default vem da nuvem
# LAN_TIMEOUT_MS=8000     # timeout das chamadas ao aparelho na LAN
