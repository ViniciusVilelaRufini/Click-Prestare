[Unit]
Description=Prestare Voz - controle das chamadas do interfone (ARI)
After=network-online.target asterisk.service
Wants=network-online.target asterisk.service

[Service]
Type=simple
# Roda como root: lê a chave TLS de /etc/prestare-voz/tls (root:turnserver 640),
# abre a porta 443 e grava /etc/asterisk/pjsip_prestare.conf (root:asterisk 640).
# Os poderes ficam limitados abaixo (só bind em porta baixa, sistema só-leitura
# fora do arquivo de contas).
User=root
EnvironmentFile=/etc/prestare-voz.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/prestare-voz/atual
ExecStart=__NODE__ src/index.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/asterisk/pjsip_prestare.conf
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
