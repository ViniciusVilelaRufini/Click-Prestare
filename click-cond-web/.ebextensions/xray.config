# Liga o daemon do AWS X-Ray na instância do Elastic Beanstalk. A API envia os
# segmentos para ele por UDP (127.0.0.1:2000) — ver apps/api/src/app/common/xray.ts.
# O role da instância precisa de xray:PutTraceSegments e xray:PutTelemetryRecords.
option_settings:
  aws:elasticbeanstalk:xray:
    XRayEnabled: true
