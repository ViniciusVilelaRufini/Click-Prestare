# Banco MySQL (Railway)
# connection_limit=25 → pool de 25 conexões simultâneas (padrão Prisma é 5, insuficiente para produção)
# pool_timeout=20     → aguarda até 20s por uma conexão disponível antes de dar erro
DATABASE_URL="mysql://user:password@host:3306/dbname?connection_limit=25&pool_timeout=20"

# JWT — autenticação de porteiros / mobile
JWT_SECRET="troque-por-um-segredo-forte-min-32-chars"
JWT_EXPIRES_IN="1d"

# CORS — origens permitidas (separadas por vírgula)
# Em produção, inclua o domínio Vercel e o domínio personalizado.
CORS_ORIGINS="http://localhost:4200,https://click-prestare.vercel.app"

# Porta da API
PORT=3000

# E-mail — envio de credenciais e recuperação de senha
# Opcao 1 (RECOMENDADA): Resend HTTP API
#   - Cadastre em resend.com e pegue a API key
#   - Funciona em qualquer ambiente (sem problema de portas/IPv6)
RESEND_API_KEY="re_xxx..."
MAIL_FROM="onboarding@resend.dev"  # ou seu dominio verificado em Resend
MAIL_FROM_NAME="Click Condomínios"

# Opcao 2 (FALLBACK): SMTP via Gmail App Password
# Usado automaticamente se RESEND_API_KEY nao estiver setado.
# Pode falhar em hosts que bloqueiam portas SMTP (ex: Railway hobby).
SMTP_SERVICE="gmail"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-app-password-do-gmail"
SMTP_FROM="seu-email@gmail.com"
SMTP_FROM_NAME="Click Condomínios"

# Storage — Cloudflare R2 (compatível com S3)
# Usado para uploads de documentos, comprovantes, fotos de visitantes/encomendas.
# Se ficar vazio, os uploads são ignorados silenciosamente.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<accountId>.r2.cloudflarestorage.com"
R2_BUCKET="click-prestare-api"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Integração com terminal facial (Control iD, Intelbras, ZKTeco, etc.)
# O enrollment LIGA SOZINHO quando há um terminal facial cadastrado — não
# precisa setar nada para começar a funcionar. Esta variável é só um
# KILL-SWITCH: defina como "false" para desligar toda a integração de uma vez.
# (Deixe sem setar / qualquer valor != "false" = ligada.)
# O IP, porta e credenciais de cada terminal ficam no banco (Facial_Devices).
# FACIAL_INTEGRATION_ENABLED="false"
FACIAL_HTTP_TIMEOUT_MS="10000"

# Token p/ o endpoint interno /facial/internal/sync/visitante/:id (mesmo valor no Express).
INTERNAL_SYNC_TOKEN=

# ---------------------------------------------------------------------------
# Notificações push (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# OBRIGATÓRIA EM PRODUÇÃO. Sem ela o NotificationsService sobe com push
# DESATIVADO e todo envio vira no-op silencioso: o app registra o fcm_token
# normalmente, o backend "envia" sem erro, e a notificação simplesmente nunca
# chega — sem nada indicando a falha além de um warn no boot.
#
# Em desenvolvimento o serviço também aceita o arquivo
# apps/api/src/assets/firebase-service-account.json, mas ele está no
# .gitignore (é chave privada) e portanto NÃO existe no build do Railway —
# por isso produção depende desta variável.
#
# Valor: o JSON da service account do Firebase, cru ou em base64.
#   Console do Firebase → Configurações do projeto → Contas de serviço →
#   Gerar nova chave privada. Depois:
#     base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Integração Superlógica (taxa condominial) — ver INTEGRACAO_SUPERLOGICA.md.
# ERP → Todos os usuários → API (Integração com outros sistemas) →
#   Aplicativos (e-mail) → Novo App Token.
# Os tokens herdam as permissões de quem os criou e VALEM 1 ANO.
SUPERLOGICA_APP_TOKEN=
SUPERLOGICA_ACCESS_TOKEN=
# Nome da licença, como aparece na URL do ERP (ex.: prestare). Reservada: nenhum
# código lê esta variável hoje (baseUrl é fixo em api.superlogica.net) e deixá-la
# vazia não quebra nada. Passa a importar se algum endpoint usado migrar para
# <licenca>.superlogica.net. Ver INTEGRACAO_SUPERLOGICA.md §3.
SUPERLOGICA_LICENCA=
