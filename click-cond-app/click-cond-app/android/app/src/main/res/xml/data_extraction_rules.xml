<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nada do app vai para o backup do Google nem para a transferência
  entre aparelhos. O app guardava a sessão (token de 365 dias) num JSON em texto
  puro nos documentos, que o Auto Backup copiava. No celular novo, é só logar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
