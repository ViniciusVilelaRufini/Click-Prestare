<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Prestare</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>prestare</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!--
	  FLUTTER_BUILD_NUMBER, e não CURRENT_PROJECT_VERSION: este é o valor que
	  o `flutter build ios` alimenta com a opção de build number. Com
	  CURRENT_PROJECT_VERSION (que estava fixo em 15 no projeto Xcode) TODO
	  build saía carimbado 15, a opção era ignorada em silêncio e o upload
	  era recusado pela Apple com "bundle version must be higher than the
	  previously uploaded version: '15'".
	-->
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>12.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>click-prestare-production.up.railway.app</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSTemporaryExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
	<!--
	  Declara que o app não usa criptografia além da que a Apple isenta (HTTPS
	  do sistema). Sem esta chave, o App Store Connect pergunta sobre
	  conformidade de exportação a CADA envio e a build fica parada esperando
	  resposta manual — o que trava um pipeline automatizado.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Os textos abaixo aparecem no alerta de permissão e são lidos pela revisão
	  da Apple. Precisam dizer PARA QUE o dado serve, em concreto: motivo
	  genérico ("para capturar uma foto") é causa recorrente de rejeição pela
	  diretriz 5.1.1. O microfone foi removido daqui — nenhuma tela do app grava
	  áudio, e permissão declarada sem uso levanta pergunta na revisão.
	-->
	<key>NSCameraUsageDescription</key>
	<string>O Prestare usa a câmera para fotografar moradores, visitantes, prestadores e funcionários no cadastro — essa foto é o que identifica a pessoa no reconhecimento facial da portaria — e para registrar encomendas e comprovantes de despesa.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Permite salvar na sua galeria as fotos e comprovantes gerados no aplicativo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Permite escolher na sua galeria a foto de cadastro de moradores, visitantes, prestadores e funcionários, além de comprovantes de encomendas e despesas do condomínio.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
