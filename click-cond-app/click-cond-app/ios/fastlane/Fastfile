# Publicação do app iOS sem Mac.
#
# Todo o build acontece no runner macOS do GitHub Actions; esta máquina de
# desenvolvimento é Windows e nunca vê um Xcode. Consequências que moldam o
# arquivo inteiro:
#
#  - Assinatura é MANUAL. Assinatura automática depende do Xcode conversando
#    com uma conta logada na UI, coisa que não existe em CI. Quem cria e
#    entrega certificado e perfil é o `match`.
#  - Nada de senha de Apple ID. A autenticação é por chave da App Store
#    Connect API, que não tem 2FA para atrapalhar um job sem interação.
#
# Lanes:
#   beta    → build + TestFlight (é o que roda no dia a dia)
#   release → envia para revisão da App Store
#   certs   → só sincroniza assinatura, para depurar sem gastar um build

default_platform(:ios)

APP_ID = "br.com.clickprestare.app"

# O time é o da conta dona da chave da App Store Connect. Fixar um ID aqui já
# quebrou o build uma vez: o match emitiu o perfil no time da chave e o
# xcodebuild procurou por outro, falhando com "No profile for team ... found".
# Por isso o valor certo é sempre o que vem do perfil recém-instalado; a
# constante existe só como fallback e pode ser sobrescrita por ambiente.
TEAM_ID = ENV["APPLE_TEAM_ID"].to_s.empty? ? "9FD7V97G5V" : ENV["APPLE_TEAM_ID"]

platform :ios do
  # A chave da App Store Connect chega em base64 porque um .p8 tem quebras de
  # linha e Secret do GitHub com múltiplas linhas é fonte de erro silencioso.
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  desc "Sincroniza certificado e perfil de distribuição (match)"
  lane :certs do
    preparar_assinatura(asc_key)
  end

  desc "Build assinado e envio para o TestFlight"
  lane :beta do
    api_key = asc_key
    profile = preparar_assinatura(api_key)
    arquivar(profile)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      # O IPA já vem pronto do passo anterior; sem isto o pilot tentaria
      # compilar de novo.
      skip_waiting_for_build_processing: true,
      # Grupos e changelog ficam para o painel: preencher aqui exigiria que o
      # texto de cada versão passasse por commit.
      distribute_external: false,
    )
  end

  desc "Build assinado e envio para revisão da App Store"
  lane :release do
    api_key = asc_key
    profile = preparar_assinatura(api_key)
    arquivar(profile)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_ID,
      # Textos da ficha, capturas e preço são editados no App Store Connect —
      # o CI só entrega o binário. `skip_metadata`/`skip_screenshots` evitam
      # que uma pasta vazia do fastlane apague o que está publicado lá.
      skip_metadata: true,
      skip_screenshots: true,
      # Não envia para revisão sozinho: a submissão é uma decisão sua, tomada
      # no painel depois de conferir o build.
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      force: true,
    )
  end

  # ---------------------------------------------------------------------------

  # Cria (ou recupera) certificado de distribuição e perfil, guardados
  # criptografados no repositório de certificados. É o que substitui o
  # "abrir o Xcode e clicar em Manage Certificates" que exigiria um Mac.
  #
  # Devolve o NOME do perfil, porque é isso que o Xcode precisa receber para
  # assinar manualmente.
  def preparar_assinatura(api_key)
    kc_password = ENV.fetch("KEYCHAIN_PASSWORD", "click_ci_temp")

    # Cria um chaveiro temporário para o CI. O runner é descartável, então
    # não tem problema criar e descartar ao fim do job. Sem isto o match
    # tenta usar um chaveiro que não existe e falha com "Could not locate
    # the provided keychain".
    create_keychain(
      name: "click_ci",
      password: kc_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      lock_after_timeout: false,
    )

    # Sem `team_id`: quem manda é a conta da chave da API. Passar um ID à mão
    # só cria a chance de ele divergir do time que realmente emite o perfil.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      api_key: api_key,
      # readonly: false porque na primeira execução não existe nada para ler —
      # é esta rodada que cria o certificado e o perfil.
      readonly: false,
      keychain_name: "click_ci",
      keychain_password: kc_password,
    )

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    profile_path = ENV["sigh_profile_path"] || lane_context[SharedValues::SIGH_PROFILE_PATH]

    # Copia o perfil para o diretório onde o xcodebuild procura — sem isto
    # o Xcode não encontra o perfil e falha com "No profile for team matching".
    if profile_path && File.exist?(profile_path)
      install_provisioning_profile(path: profile_path)
    end

    # O match publica o time do perfil nesta variável. É a única fonte que não
    # pode divergir do que foi de fato instalado no runner.
    team_id = ENV["sigh_#{APP_ID}_appstore_team-id"].to_s
    team_id = TEAM_ID if team_id.empty?
    UI.message("Assinando com o time #{team_id} e o perfil '#{profile_name}'")

    { name: profile_name, team_id: team_id }
  end

  def arquivar(profile)
    profile_name = profile[:name]
    team_id = profile[:team_id]

    # O projeto vem configurado para assinatura automática (é como o Flutter
    # gera). Reescrever para manual ANTES de arquivar é obrigatório: o gym
    # respeita o que está no pbxproj, não o que o match acabou de instalar.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: team_id,
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Click.ipa",
      # Aponta o xcodebuild para o chaveiro do CI, onde o certificado está.
      xcargs: "OTHER_CODE_SIGN_FLAGS='--keychain ~/Library/Keychains/click_ci'",
      # Silencia o aviso de bitcode (aposentado pela Apple) e garante que o
      # export use exatamente o perfil do match.
      export_options: {
        provisioningProfiles: { APP_ID => profile_name },
        signingStyle: "manual",
        teamID: team_id,
      },
    )
  end
end
