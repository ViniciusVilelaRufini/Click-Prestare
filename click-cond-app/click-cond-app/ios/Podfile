# iOS 15 é o piso do Firebase Apple SDK usado pelo firebase_core 4.x. O
# Podfile.lock versionado ainda é de antes do Firebase entrar no pubspec (não
# tem nenhum pod dele), então o primeiro `pod install` no CI é que vai resolver
# a árvore de verdade — se algum pod pedir mais que 15, o erro aponta o número.
$FirebaseSDKVersion = '10.29.0'

platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # permission_handler (iOS): cada permissão só é compilada com a macro
      # ligada; sem ela o pedido devolve "negado" sem mostrar o alerta. O app
      # pede por ele o microfone (interfone) e as notificações (perfil_choice).
      # Câmera e fotos vêm do image_picker e do mobile_scanner, que pedem
      # sozinhos; o ditado do assistente pede o microfone pelo speech_to_text.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      # Pode vir como texto ("$(inherited) DEBUG=1"): vira lista antes de somar.
      definicoes = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
      definicoes = definicoes.split(' ') if definicoes.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definicoes | [
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
